  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/rbush": "^4.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
